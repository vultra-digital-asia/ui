{
  "name": "vultra-ui",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo for @vultra/* UI component library",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @vultra/storybook storybook",
    "build": "pnpm --filter @vultra/tokens build && pnpm --filter @vultra/ui build",
    "build:tokens": "pnpm --filter @vultra/tokens build",
    "build:core": "pnpm --filter @vultra/ui build",
    "build:all": "pnpm -r run build",
    "storybook": "pnpm --filter @vultra/storybook storybook",
    "build-storybook": "pnpm --filter @vultra/storybook build-storybook",
    "check": "pnpm -r run check",
    "lint": "pnpm -r run lint",
    "format": "prettier --write .",
    "version": "changeset version",
    "changeset": "changeset",
    "publish": "changeset publish",
    "stage:apply": "npm stage apply",
    "cli": "pnpm --filter @vultra/cli build",
    "generate:registry": "pnpm --filter @vultra/cli generate:registry"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/svelte": "^5.4.2",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "prettier": "^3.5.0",
    "prettier-plugin-svelte": "^3.5.0",
    "typescript": "^6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "@vultra/tokens": "link:packages/tokens",
      "tokens": "link:../../../../Library/pnpm/global/5/node_modules/@vultra/tokens"
    }
  },
  "dependencies": {
    "@vultra/tokens": "link:packages/tokens",
    "tokens": "link:../../../../Library/pnpm/global/5/node_modules/@vultra/tokens"
  }
}
