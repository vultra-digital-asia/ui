{
  "name": "@vultra/screens",
  "version": "0.1.1-alpha.2",
  "description": "Ready-to-use benchmark full-page screens and composable templates for Vultra UI (Web & Mobile)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "module": "./dist/index.js"
    },
    "./components/*": {
      "types": "./dist/components/*/index.d.ts",
      "svelte": "./dist/components/*/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "svelte-package -o dist",
    "check": "echo 'no check'",
    "dev": "svelte-package -o dist -w"
  },
  "dependencies": {
    "@ark-ui/svelte": "^5.24.1",
    "@vultra/tokens": "workspace:*",
    "clsx": "^2.1.1",
    "lucide-svelte": "^1.0.1",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.3.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.5.8",
    "svelte": "^5.55.2",
    "typescript": "^6.0.2"
  },
  "peerDependencies": {
    "svelte": "^5.0.0",
    "tailwindcss": "^4.0.0"
  },
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vultra-digital-asia/ui.git",
    "directory": "packages/screens"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
